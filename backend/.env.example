# ─── ResearchForm Production Environment ─────────────────────────────────────
# Copy this file to .env (at the project root or backend/) and fill in values.
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# For production: use PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SECURE_PASSWORD@localhost:5432/researchform
SYNC_DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@localhost:5432/researchform
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# For local development only (SQLite — no Postgres needed)
# DATABASE_URL=sqlite+aiosqlite:///./researchform_dev.db
# SYNC_DATABASE_URL=sqlite:///./researchform_dev.db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Anthropic (Claude) — primary analysis engine
ANTHROPIC_API_KEY=

# OpenRouter (free alternative — sign up at https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Payments (Paystack — Nigerian Naira) ─────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Payments (Stripe — USD) ──────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLIC_KEY=pk_live_...

# ── Social Login ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App Settings ─────────────────────────────────────────────────────────────
DOMAIN=researchform.app                   # Your production domain
FRONTEND_URL=https://researchform.app
NEXT_PUBLIC_API_URL=https://api.researchform.app

APP_NAME=ResearchForm
DEBUG=false
DEV_MODE=false

# ── Credit & Billing Config ───────────────────────────────────────────────────
SIGNUP_BONUS_CREDITS=5.0
# CREDIT_PER_1K_INPUT_TOKENS=0.35
# CREDIT_PER_1K_OUTPUT_TOKENS=1.75
# CREDIT_MARKUP_MULTIPLIER=1.40
# CREDIT_MIN_REPORT_CHARGE=2.0

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=storage
CHARTS_DIR=storage/charts
REPORTS_DIR=storage/reports

# S3/MinIO (optional — for cloud storage)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_BUCKET_DATASETS=researchform-datasets

# ── CORS (comma-separated) ────────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://researchform.app","http://localhost:3000"]

# ── Redis (for Celery background tasks) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
